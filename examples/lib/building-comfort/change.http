### ============================================================
### ADD NEW ROOM
### ============================================================

### Insert New Room Node
POST http://localhost:9000/sources/sensors/events
Content-Type: application/json

{
  "operation": "insert",
  "element": {
    "type": "node",
    "id": "room_105",
    "labels": ["Room"],
    "properties": {
      "name": "Room 105",
      "temp": 72,
      "humidity": 42,
      "co2": 500
    }
  }
}

### Create PART_OF Relationship for New Room
POST http://localhost:9000/sources/sensors/events
Content-Type: application/json

{
  "operation": "insert",
  "element": {
    "type": "relation",
    "id": "rel_105",
    "startId": "room_105",
    "endId": "floor_01",
    "labels": ["PART_OF"]
  }
}

### ============================================================
### DELETE ROOM
### ============================================================

### Delete Room 105 Relationship First
POST http://localhost:9000/sources/sensors/events
Content-Type: application/json

{
  "operation": "delete",
  "element": {
    "type": "relation",
    "id": "rel_105",
    "startId": "room_105",
    "endId": "floor_01",
    "labels": ["PART_OF"]
  }
}

### Delete Room 105 Node
POST http://localhost:9000/sources/sensors/events
Content-Type: application/json

{
  "operation": "delete",
  "element": {
    "type": "node",
    "id": "room_105",
    "labels": ["Room"],
    "properties": {
      "name": "Room 105",
      "temp": 72,
      "humidity": 42,
      "co2": 500
    }
  }
}

### ============================================================
### BATCH UPDATE - Update Multiple Rooms
### ============================================================

### Batch Update - All First Floor Rooms Get Warmer
POST http://localhost:9000/sources/sensors/events/batch
Content-Type: application/json

[
  {
    "operation": "update",
    "element": {
      "type": "node",
      "id": "room_101",
      "labels": ["Room"],
      "properties": {
        "name": "Room 101",
        "temp": 76,
        "humidity": 45,
        "co2": 520
      }
    }
  },
  {
    "operation": "update",
    "element": {
      "type": "node",
      "id": "room_102",
      "labels": ["Room"],
      "properties": {
        "name": "Room 102",
        "temp": 77,
        "humidity": 48,
        "co2": 530
      }
    }
  },
  {
    "operation": "update",
    "element": {
      "type": "node",
      "id": "room_103",
      "labels": ["Room"],
      "properties": {
        "name": "Room 103",
        "temp": 75,
        "humidity": 44,
        "co2": 510
      }
    }
  },
  {
    "operation": "update",
    "element": {
      "type": "node",
      "id": "room_104",
      "labels": ["Room"],
      "properties": {
        "name": "Room 104",
        "temp": 76,
        "humidity": 46,
        "co2": 490
      }
    }
  }
]

